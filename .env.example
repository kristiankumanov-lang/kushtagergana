# Booking.com "Sync calendar" iCal export URL (Extranet → Calendar → Sync calendars).
# Leave unset locally to see the graceful "Наличността се потвърждава от домакина" fallback.
BOOKING_ICAL_URL=

# Resend (https://resend.com) — used to email booking requests to the host.
RESEND_API_KEY=
# Must be a verified sender on your Resend domain, e.g. "Къща Гергана <booking@your-domain.bg>"
GUESTHOUSE_EMAIL_FROM=
# Where booking request emails are delivered (the host's inbox).
GUESTHOUSE_OWNER_EMAIL=
# Host's phone number, shown to guests as a fallback contact and used in
# email signatures. Plain text, e.g. "+359 88 123 4567".
GUESTHOUSE_PHONE=

# Direct Postgres connection to the Supabase project's `guesthouse` schema
# (Transaction Pooler, role `guesthouse_app`). Used for persisting booking
# enquiries and the confirm/decline token flow — never exposed to the client.
DATABASE_URL=

# Public site URL, used for canonical/OG tags, the sitemap, and building the
# absolute confirm/decline links sent in the owner notification email.
NEXT_PUBLIC_SITE_URL=https://kushta-gergana.bg
